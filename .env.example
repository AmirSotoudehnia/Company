AGENT_COMPANY_DB=/data/agent_company.db

# Repository target
GITHUB_OWNER=AmirSotoudehnia
GITHUB_REPO=Company

# Development fallback only. Production should prefer GitHub App auth.
GITHUB_TOKEN=

# GitHub App auth (recommended for customer repositories)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=

WORKSPACE_ROOT=/tmp/agent-company-workspaces
TEST_COMMAND=python -m pytest -q
COMMAND_TIMEOUT_SECONDS=180

# Untrusted repository code must use Docker.
EXECUTION_MODE=docker
ALLOW_LOCAL_EXECUTION=false
SANDBOX_IMAGE=agent-company-sandbox:py312
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
SANDBOX_NETWORK=none
SANDBOX_USER=1000:1000

LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
