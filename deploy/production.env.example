AGENT_COMPANY_DB=/var/lib/agent-company/agent_company.db
WORKSPACE_ROOT=/tmp/agent-company-workspaces
EXECUTION_MODE=docker
ALLOW_LOCAL_EXECUTION=false
SANDBOX_IMAGE=agent-company-sandbox:py312
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1.0
SANDBOX_PIDS=256
SANDBOX_NETWORK=none
SANDBOX_USER=1000:1000
COMMAND_TIMEOUT_SECONDS=180
TEST_COMMAND=python -m pytest -q

# Control-plane bootstrap. Replace with a long random value, bootstrap tenants, then rotate/disable.
BOOTSTRAP_TOKEN=CHANGE_ME_LONG_RANDOM_VALUE

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/agent-company/github-app.pem
GITHUB_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# LLM provider
LLM_MODE=remote
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Legacy single-repo mode should normally remain unset in multi-tenant production.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
